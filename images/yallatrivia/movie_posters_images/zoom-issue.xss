      <property name="padding-bottom">0px</property>
    </style>
  </styleSheet>
  <!-- ==================== Sheet: Internet Explorer (all versions) ==================== -->
  <styleSheet browsers="ie">
    <style selector="#skins4stylesheet">
      <property name="font-family">ie</property>
    </style>
    <style selector="@font-face">
      <includeStyle name="OpenSans"/>
    </style>
    <style selector="@import; @font-face">
      <includeStyle name="OpenSansBold"/>
    </style>
    <style selector="@import;@font-face">
      <includeStyle name="OpenSansLight"/>
    </style>
    <!-- The Following Code is to support IE11 operating in X UA Compatibility Mode. Oracle system generates IE but not a version. Then reset any differences for 5 6 7 8 9 -->
    <style selector=".OraTableContentContainer">
      <property name="border-bottom-width">1px</property>
    </style>
  </styleSheet>
  <!-- ==================== Sheet: Internet Explorer on Windows ==================== -->
  <styleSheet platforms="windows" browsers="ie">
    <style selector="#skins4stylesheet">
      <property name="font-family">windows,ie</property>
    </style>
    <style name="DefaultFontFamily">
      <property name="font-family">"fund",lato,arial,sans-serif</property>
      <property name="font-weight">400</property>
    </style>
    <style name="DefaultFontFamilyBold">
      <property name="font-family">"fund",lato,arial,sans-serif</property>
      <property name="font-weight">600</property>
    </style>
    <style name="DefaultFont">
      <property name="font-size">14px</property>
    </style>
    <style name="VerySmallFont">
      <property name="font-size">0.714em</property>
    </style>
    <style name="SmallFont">
      <property name="font-size">0.857em</property>
    </style>
    <style name="MediumFont">
      <property name="font-size">1em</property>
    </style>
    <style name="LargeFont">
      <property name="font-size">1.286em</property>
    </style>
    <style name="TextForeground">
      <property name="color">#5D5D5D</property>
    </style>
    <style selector="button">
      <property name="width"/>
    </style>
    <style selector="button.p_SwabuttonEnabled">
