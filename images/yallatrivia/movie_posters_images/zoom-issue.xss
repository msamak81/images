    <style selector=".OraPopupBody .OraBodyContainer, .OraPopupBody div.OraBodyContainer > form > span > table, .OraLongTipPopup, .OraLongTipPopup .OraBodyContainer, .OraLongTipPopup div.OraBodyContainer > form > span > table">
