    <!-- ==================== Shared Styles - reusable groups, used via includeStyle ==================== -->
    <!-- White button with green text (Cancel, Back, Save for Later ...) -->
    <style name="SecondaryButton">
      <property name="background">var(--color-primary-white)</property>
      <property name="color">var(--color-btn-bg-default)</property>
      <property name="padding">0 16px</property>
    </style>
    <!-- Standard 24px touch icon size -->
    <style name="TouchIconSize">
      <property name="height">1.714em</property>
      <property name="width">1.714em</property>
    </style>
    <!-- Fade-in animation on page load -->
    <style name="FadeIn">
      <property name="-moz-animation">fadein 1s</property>
      <property name="-webkit-animation">fadein 1s</property>
      <property name="animation">fadein 1s</property>
    </style>
    <!-- ==================== Base Page (html, body, containers) ==================== -->
