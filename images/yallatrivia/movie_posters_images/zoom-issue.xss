  <styleSheet direction="rtl" browsers="ie">
    <style selector="#skins4stylesheet">
      <property name="font-family">rtl,ie</property>
    </style>
    <style selector="@font-face">
      <includeStyle name="DroidKufi"/>
    </style>
    <style selector="@import; @font-face">
      <includeStyle name="DroidKufiBold"/>
    </style>
    <style selector="@import;@font-face">
      <includeStyle name="OpenSansLight"/>
    </style>
  </styleSheet>
  <!-- ==================== Sheet: Right-to-left, Internet Explorer 5-9 ==================== -->
  <styleSheet direction="rtl" browsers="ie" versions="5 6 7 8 9">
    <style selector="@font-face">
      <includeStyle name="OpenSansIE"/>
    </style>
    <style selector="@import; @font-face">
      <includeStyle name="OpenSansBoldIE"/>
    </style>
    <style selector="@import;@font-face">
      <includeStyle name="OpenSansLightIE"/>
    </style>
  </styleSheet>
  <!-- ==================== Sheet: Right-to-left, Internet Explorer on Windows ==================== -->
  <styleSheet direction="rtl" platforms="windows" browsers="ie">
    <style selector="#skins4stylesheet">
      <property name="font-family">rtl,windows,ie</property>
    </style>
    <style name="DefaultFontFamily">
      <property name="font-family">"fund",sans-serif</property>
      <property name="font-weight">400</property>
    </style>
    <style name="DefaultFontFamilyBold">
      <property name="font-family">"fund",sans-serif</property>
      <property name="font-weight">700</property>
    </style>
  </styleSheet>
</styleSheetDocument>
