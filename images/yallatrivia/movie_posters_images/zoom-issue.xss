    <!-- ==================== Global Buttons ==================== -->
    <style selector=".pageHeader1">
      <property name="border-width">0px</property>
      <property name="border-style">none</property>
      <property name="border-collapse">collapse</property>
    </style>
    <style selector=".pageHeader1 > td">
      <property name="border-width">0px</property>
      <property name="border-style">none</property>
      <property name="border-collapse">collapse</property>
      <property name="padding">0px 0px 0px 0px</property>
    </style>
    <style selector="table#globalHeaderID">
      <property name="border-radius">10px</property>
      <property name="background">rgba(255,255,255,0)</property>
      <property name="border-width">0px</property>
      <property name="border-style">none</property>
      <property name="border-collapse">collapse</property>
      <property name="padding">0px 0px 0px 0px</property>
    </style>
    <style selector="table#globalHeaderID > tbody > tr, table#globalHeaderID > tbody > tr > td">
      <property name="border-width">0px</property>
      <property name="border-style">none</property>
      <property name="border-collapse">collapse</property>
      <property name="padding">0px 0px 0px 0px</property>
    </style>
    <style name="GlobalButton">
      <includeStyle name="DefaultFontFamily"/>
      <property name="color">#161616</property>
      <!-- changes for hover status - done by samak Nabil -->
      <property name="font-size">1em</property>
      <property name="font-weight">normal</property>
      <property name="white-space">nowrap</property>
    </style>
    <style name="DefaultHeaderLinks">
      <includeStyle name="GlobalButton"/>
      <property name="color">#161616</property>
    </style>
    <style name="GlobalButtonHover">
      <property name="color">#161616</property>
    </style>
    <style selector=".OraGlobalButtonText">
      <includeStyle name="GlobalButton"/>
    </style>
    <style selector=".OraGlobalButtonTextSelected">
      <includeStyle name="GlobalButton"/>
      <includeStyle name="DefaultFontBold"/>
    </style>
    <style selector=".universalGlobalButton > div">
      <includeStyle name="DefaultFontFamily"/>
    </style>
    <!-- has padding left 20px with rtl 20px in R1227 -->
    <style selector=".OraUniversalNavigator">
      <property name="background">rgba(255, 255, 255, 0)</property>
      <property name="padding-top">25px</property>
      <property name="padding-bottom">25px</property>
      <property name="padding-left">20px</property>
      <property name="padding-right">20px</property>
    </style>
    <style selector=".OraUniversalNavigator:hover">
    </style>
    <style selector=".universalGlobalButton">
      <property name="padding"/>
      <includeStyle name="DefaultHeaderLinks"/>
      <property name="background">rgba(255, 255, 255, 0.0)</property>
      <property name="display">inline-block</property>
      <property name="text-align">center</property>
      <property name="padding-top">10px</property>
      <property name="padding-bottom">10px</property>
      <property name="padding-left">10px</property>
      <property name="padding-right">10px</property>
      <property name="border-width">0px</property>
      <property name="border-style">none</property>
      <property name="border-collapse">collapse</property>
      <property name="margin">0px 2px 0px</property>
    </style>
    <style selector="#globalHeaderID > tbody > tr > td > *[href*=help_window], #globalHeaderID > tbody > tr > td > *[href*=OALogout]">
      <property name="background">rgba(255, 255, 255, 0.0)</property>
    </style>
    <style selector="#globalHeaderID > tbody > tr > td > *[href*=help_window]:hover, #globalHeaderID > tbody > tr > td > *[href*=OALogout]:hover">
      <property name="background">rgba(255, 255, 255, 0.15)</property>
    </style>
    <style selector=".universalGlobalButton:hover, .universalGlobalButton:visited">
      <includeStyle name="GlobalButton"/>
      <property name="color">var(--color-text-default) !important</property>
      <!-- <includeStyle name="GlobalButtonHover"/> done by samak - waiting for dga design systemn hover status -->
      <property name="background">rgba(255, 255, 255, 0.15)</property>
    </style>
    <style selector=".universalGlobalButtonSelected">
      <property name="padding"/>
      <includeStyle name="GlobalButton"/>
      <includeStyle name="GlobalButtonHover"/>
      <includeStyle name="DefaultFontBold"/>
      <property name="background">rgba(255, 255, 255, 0.15)</property>
      <property name="display">inline-block</property>
      <property name="text-align">center</property>
      <property name="padding-top">10px</property>
      <property name="padding-bottom">10px</property>
      <property name="padding-left">14px</property>
      <property name="padding-right">14px</property>
      <property name="position">relative</property>
      <property name="z-index">1</property>
    </style>
    <style selector=".universalGlobalButtonSelected:hover">
      <includeStyle name="GlobalButton"/>
      <includeStyle name="GlobalButtonHover"/>
      <includeStyle name="DefaultFontBold"/>
      <property name="background">rgba(255, 255, 255, 0.15)</property>
    </style>
    <style selector=".universalGlobalButtonDisabled">
      <includeStyle name="GlobalButton"/>
      <includeStyle name="DefaultFontFamily"/>
      <property name="background">rgba(255, 255, 255, 0)</property>
