  <!-- Alternative Browser Changes -->
  <!-- ==================== Sheet: WebKit (Chrome, Safari, Edge) only ==================== -->
  <styleSheet browsers="webkit">
    <style selector="#skins4stylesheet">
      <property name="font-family">webkit</property>
    </style>
  </styleSheet>
  <!-- ==================== Sheet: Gecko (Firefox) only ==================== -->
  <styleSheet browsers="gecko">
    <style selector="#skins4stylesheet">
      <property name="font-family">gecko</property>
    </style>
