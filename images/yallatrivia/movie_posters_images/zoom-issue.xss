    <style resetProperties="true" name="DefaultFontFamily"> </style>
    <style name="DefaultFontFamily">
      <property name="font-family">"fund",lato,arial,sans-serif</property>
    </style>
    <style name="DefaultFontFamilyImportant">
      <property name="font-family">"fund",lato,arial,sans-serif !important</property>
    </style>
    <style name="DefaultFontFamilyBold">
      <property name="font-family">"fund",lato,arial,sans-serif</property>
      <property name="font-weight">600</property>
    </style>
    <style name="SecondaryFontFamily">
      <property name="font-family">"fund",lato,arial,sans-serif</property>
    </style>
