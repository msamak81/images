<?xml version="1.0" encoding="UTF-8"?>
<styleSheetDocument xmlns="http://xmlns.oracle.com/uix/style" version="2.0" documentVersion="_1">
  <!-- ... ..` ;;;;;;;: ;;; ;;;; ;;; ;;; ;;; `;;;;;;;` ; ;;;;;;;;; ;;; ;;;; ;;; ;;;; ;;; ;;;;;;;;; ; ;;; :;, ;;; ;;;; ;;; ;;;;; ;;; :;;; `;; ;; ;;; ;;; :;;; ;;; ;;;;;, ;;; :;;; ;.; ;;;;;: ;;;,;;; ;;; ;;:;;; ;;; `;;;;;. .; ; `;;;;;;; ;;;;;;;: ;;; ;;;`;;; ;;; :;;;;;;: ; ; .;;;;;; ;;;;;;;; ;;; ;;; :;;;;;; ,;;;;;: ;;;;;: .;;; ;;;;.;;;; ;;; ;;; ;;;;;; ;;;; ; `;: ;;; ;;;, ;;;; ;;; ;;; ;;;;; ;;. ;;; ; ;;;;;;;;;; ;;; .;;; ;;; ;;; ;;;; ;;;;;;;;;; `;;;;;;;;` ;;; ;;;; ;;; ;;; ,;;; ,;;;;;;;; :;;;, ;:: :::;;:: ::; ;:: .:;;;. Created by Skins4 Note: This skin should not be distributed to unathorized parties without prior consent -->
  <!--
    Table of contents (search for "==== <name>" to jump to a section).
    Rule order matters: later rules override earlier ones, so do not reorder sections.

     1. Theme Variables
     2. Fonts
     3. Base Page (html, body, containers)
     4. Default Element Styles
     5. Backgrounds
     6. Fade-in Animations
     7. Page Structure
     8. Page Buttons
     9. Buttons
    10. Logo
    11. Global Buttons
    12. User Details
    13. Slideout Menu
    14. Product Branding
    15. Tab Bar
    16. Sub Tabs
    17. Global Header
    18. Headers
    19. Breadcrumbs
    20. Train
    21. Side Bar
    22. Tree
    23. Message Box
    24. Content Container
    25. Footer
    26. Links
    27. Text Sizes
    28. Calendar
    29. Inputs
    30. Tables
    31. Homepage Worklist
    32. Popups
    33. Detach
    34. Loading
    35. Navigator
    36. iRec Home
    37. OLM Fixes
    38. Entitlement Balances
    39. Performance Plans
    40. Icons
    41. DGA Theme Overrides (nabil and samak)
    42. Sheet: WebKit (Chrome, Safari, Edge) only
    43. Sheet: Gecko (Firefox) only
    44. Sheet: Internet Explorer (all versions)
    45. Sheet: Internet Explorer on Windows
    46. Sheet: Internet Explorer 5-9
    47. Sheet: Internet Explorer 8-9 on Windows
    48. Sheet: Internet Explorer 10-11 on Windows
    49. Sheet: Right-to-left (Arabic) layout
    50. Sheet: Right-to-left, Internet Explorer
    51. Sheet: Right-to-left, Internet Explorer 5-9
    52. Sheet: Right-to-left, Internet Explorer on Windows
  -->
  <styleSheet>
    <!-- ==================== Theme Variables (DGA palette) - change colors here ==================== -->
    <!-- Root variables mapped to named styles or properties -->
    <style selector=":root">
      <property name="--color-primary-green-darkest">#0F2E29</property>
      <property name="--color-primary-green">#005C4D</property>
      <property name="--color-primary-gold">#C4984F</property>
      <property name="--color-primary-white">#ffffff</property>
      <property name="--color-secondary-grey-darkest">#262626</property>
      <property name="--color-secondary-grey-dark">#3B3B3B</property>
      <property name="--color-secondary-grey-mid">#929087</property>
      <property name="--color-secondary-grey-concrete">#C5C5C5</property>
      <property name="--color-secondary-green-light">#0EB599</property>
      <property name="--color-secondary-gold-dark">#937D53</property>
      <property name="--color-neutral-sand-dark">#322F2B</property>
      <property name="--color-neutral-sand-light">#FAF6EE</property>
      <property name="--color-neutral-sand-pale">#FAF9F7</property>
      <property name="--color-neutral-green-pale">#D4E8E3</property>
      <property name="--color-neutral-grey-light">#E6E6E6</property>
      <property name="--color-neutral-grey-pale">#F5F5F5</property>
      <property name="--color-system-red">#DB0000</property>
      <property name="--color-system-red-light">hsla(0, 71%, 64%, 0.5)</property>
      <property name="--color-status-warning">#FF7842</property>
      <property name="--color-status-warning-light">hsla(17, 100%, 63%, 0.1)</property>
      <property name="--color-status-success">#00D47F</property>
      <property name="--color-status-success-light">hsla(156, 100%, 42%, 0.1)</property>
      <property name="--color-status-error">#FF4242</property>
      <property name="--color-status-error-light">hsla(0, 100%, 63%, 0.1)</property>
      <property name="--color-status-info">#139DFF</property>
      <property name="--color-status-info-light">hsla(205, 100%, 54%, 0.1)</property>
      <property name="--color-orange-primary">#BC6322</property>
      <property name="--color-orange-light">#FFD399</property>
      <property name="--color-orange-mid">#FE9D56</property>
      <property name="--color-orange-dark">#4A2912</property>
      <property name="--color-violet-primary">#600080</property>
      <property name="--color-violet-light">#F5D6FF</property>
      <property name="--color-violet-mid">#8204AC</property>
      <property name="--color-violet-dark">#2A0038</property>
      <property name="--color-purple-primary">#29176F</property>
      <property name="--color-purple-light">#A8B1FF</property>
      <property name="--color-purple-mid">#472BD0</property>
      <property name="--color-purple-dark">#0C0138</property>
      <property name="--color-pink-primary">#B31D42</property>
      <property name="--color-pink-light">#F0A7B9</property>
      <property name="--color-pink-mid">#EB3865</property>
      <property name="--color-pink-dark">#4D0C1C</property>
      <property name="--color-teal-primary">#015A66</property>
      <property name="--color-teal-light">#B5F6FF</property>
      <property name="--color-teal-mid">#0298AC</property>
      <property name="--color-teal-dark">#0D3338</property>
      <property name="--color-info-bg">hsla(205, 100%, 54%, 0.1)</property>
      <property name="--color-info-default">hsla(205, 100%, 54%, 1)</property>
      <property name="--color-btn-bg-default">var(--color-primary-green)</property>
      <property name="--color-btn-bg-hover">var(--color-primary-green-darkest)</property>
      <property name="--color-btn-bg-focus">var(--color-primary-green)</property>
      <property name="--color-btn-bg-disabled">var(--color-neutral-grey-light)</property>
      <property name="--color-btn-text-default">var(--color-primary-white)</property>
      <property name="--color-btn-texty-disabled">var(--color-secondary-grey-mid)</property>
      <property name="--color-background-menu">#ffffff</property>
      <property name="--color-background-body">#f9fafb</property>
      <property name="--color-background-footer">#F3F4F6</property>
      <property name="--color-border-primary">#D2D6DB</property>
      <property name="--color-text-default">#161616</property>
      <property name="--color-text-secondary">#6C737F</property>
    </style>
